{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "type": "command",
        "matcher": ".*autodev-(?:architecture|security|privacy)-review",
        "bash": "bash \"${PLUGIN_ROOT}/hooks/scripts/autodev-gates.sh\" subagentStart",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/scripts/autodev-gates.ps1\" subagentStart",
        "timeoutSec": 20
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "bash \"${PLUGIN_ROOT}/hooks/scripts/autodev-gates.sh\" subagentStop",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/scripts/autodev-gates.ps1\" subagentStop",
        "timeoutSec": 20
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "bash \"${PLUGIN_ROOT}/hooks/scripts/autodev-gates.sh\" agentStop",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/scripts/autodev-gates.ps1\" agentStop",
        "timeoutSec": 20
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "ask_user",
        "bash": "bash \"${PLUGIN_ROOT}/hooks/scripts/autodev-gates.sh\" preToolUse",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/scripts/autodev-gates.ps1\" preToolUse",
        "timeoutSec": 20
      }
    ]
  }
}

